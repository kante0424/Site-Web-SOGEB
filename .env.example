# Copier ce fichier en « .env » sur le serveur et remplir les valeurs. Ne jamais versionner le fichier .env.

# Clé secrète Django, à générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Noms de domaine autorisés, séparés par des virgules (ex. : www.sogeb.gn,sogeb.gn)
DJANGO_ALLOWED_HOSTS=
WAGTAILADMIN_BASE_URL=https://www.exemple.gn

# Base de données (le mot de passe doit être identique dans les deux lignes)
POSTGRES_DB=sogeb
POSTGRES_USER=sogeb
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sogeb:MOT_DE_PASSE@db:5432/sogeb

# Messagerie (compte SMTP fourni par la DSSI)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=site-web@exemple.gn
